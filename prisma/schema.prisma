model AutorizacaoBiometricaMarcacao {
  id         String  @id @default(uuid()) @db.Uuid
  servidorId String  @map("servidor_id") @db.Uuid
  amostraId  String? @map("amostra_id") @db.Uuid

  tokenHash String                      @map("token_hash") @db.VarChar(128)
