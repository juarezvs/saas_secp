  usuarioId           String   @map("usuario_id") @db.Uuid
  servidorId          String?  @map("servidor_id") @db.Uuid
  teamsUserId         String   @map("teams_user_id") @db.VarChar(180)
  teamsAadObjectId    String?  @map("teams_aad_object_id") @db.VarChar(180)
  teamsConversationId String?  @map("teams_conversation_id") @db.Text
  tenantId            String?  @map("tenant_id") @db.VarChar(120)
  serviceUrl          String?  @map("service_url") @db.Text
  ativo               Boolean  @default(true)
  criadoEm            DateTime @default(now()) @map("criado_em")
  atualizadoEm        DateTime @updatedAt @map("atualizado_em")

  usuario  Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  servidor Servidor? @relation(fields: [servidorId], references: [id], onDelete: SetNull)

  @@unique([teamsUserId, tenantId])
  @@index([usuarioId])
  @@index([servidorId])
  @@index([teamsAadObjectId])
  @@index([ativo])
  @@map("teams_usuarios_vinculados")
}

model TeamsLog {
  id            String   @id @default(uuid()) @db.Uuid
  tipo          String   @db.VarChar(80)
  direcao       String   @db.VarChar(40)
  usuarioId     String?  @map("usuario_id") @db.Uuid
  teamsUserId   String?  @map("teams_user_id") @db.VarChar(180)
  evento        String   @db.VarChar(160)
  payloadResumo String?  @map("payload_resumo") @db.Text
  sucesso       Boolean  @default(true)
  erro          String?  @db.Text
  criadoEm      DateTime @default(now()) @map("criado_em")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([tipo])
  @@index([direcao])
  @@index([usuarioId])
  @@index([teamsUserId])
  @@index([evento])
  @@index([sucesso])
  @@index([criadoEm])
  @@map("teams_logs")
}

model TeamsNotificacao {
  id          String    @id @default(uuid()) @db.Uuid
  usuarioId   String    @map("usuario_id") @db.Uuid
  teamsUserId String?   @map("teams_user_id") @db.VarChar(180)
  titulo      String    @db.VarChar(180)
  mensagem    String    @db.Text
  tipo        String    @db.VarChar(80)
  status      String    @default("pendente") @db.VarChar(40)
