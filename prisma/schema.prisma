}

model LogIntegracao {
  id           String  @id @default(uuid()) @db.Uuid
  integracaoId String? @map("integracao_id") @db.Uuid

  tipo    TipoIntegracao
  direcao DirecaoIntegracao
  status  StatusLogIntegracao

  entidade   String? @db.VarChar(120)
  entidadeId String? @map("entidade_id") @db.VarChar(120)

  mensagem String? @db.Text
  erro     String? @db.Text

  payloadEntrada Json? @map("payload_entrada")
  payloadSaida   Json? @map("payload_saida")
  metadados      Json?

  iniciadoEm   DateTime  @default(now()) @map("iniciado_em")
  finalizadoEm DateTime? @map("finalizado_em")
  duracaoMs    Int?      @map("duracao_ms")

  integracao IntegracaoSistema? @relation(fields: [integracaoId], references: [id], onDelete: SetNull)

  @@index([integracaoId])
  @@index([tipo])
  @@index([status])
  @@index([entidade])
  @@index([entidadeId])
  @@index([iniciadoEm])
