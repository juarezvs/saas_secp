model MapeamentoExterno {
  id String @id @default(uuid()) @db.Uuid

  integracaoId String?          @map("integracao_id") @db.Uuid
  sistema      TipoIntegracao
  tipoRegistro TipoRegistroSarh @map("tipo_registro")

  codigoExterno     String @map("codigo_externo") @db.VarChar(120)
  entidadeInterna   String @map("entidade_interna") @db.VarChar(120)
  entidadeInternaId String @map("entidade_interna_id") @db.VarChar(120)

  hashAtual String? @map("hash_atual") @db.VarChar(128)
  ativo     Boolean @default(true)
  metadados Json?

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  integracao IntegracaoSistema? @relation(fields: [integracaoId], references: [id], onDelete: SetNull)

  @@unique([sistema, tipoRegistro, codigoExterno])
  @@index([integracaoId])
  @@index([entidadeInterna, entidadeInternaId])
  @@index([ativo])
  @@map("mapeamentos_externos")
}

model IntegracaoSarhExecucao {
  id String @id @default(uuid()) @db.Uuid

  integracaoId         String  @map("integracao_id") @db.Uuid
  iniciadoPorUsuarioId String? @map("iniciado_por_usuario_id") @db.Uuid

  tipo          TipoExecucaoIntegracaoSarh
  status        StatusExecucaoIntegracaoSarh @default(AGENDADA)
  modoSimulacao Boolean                      @default(false) @map("modo_simulacao")

  totalRecebidos   Int @default(0) @map("total_recebidos")
  totalCriados     Int @default(0) @map("total_criados")
  totalAtualizados Int @default(0) @map("total_atualizados")
  totalInativados  Int @default(0) @map("total_inativados")
  totalIgnorados   Int @default(0) @map("total_ignorados")
  totalErros       Int @default(0) @map("total_erros")
  totalConflitos   Int @default(0) @map("total_conflitos")

  mensagemErro String? @map("mensagem_erro") @db.Text
  metadados    Json?

  iniciadoEm   DateTime  @default(now()) @map("iniciado_em")
  finalizadoEm DateTime? @map("finalizado_em")
  duracaoMs    Int?      @map("duracao_ms")

  integracao         IntegracaoSistema @relation(fields: [integracaoId], references: [id], onDelete: Restrict)
  iniciadoPorUsuario Usuario?          @relation("IntegracoesSarhExecutadasPorUsuario", fields: [iniciadoPorUsuarioId], references: [id], onDelete: SetNull)

  registrosBrutos RegistroBrutoSarh[]
  itens           IntegracaoSarhItem[]
  conflitos       IntegracaoSarhConflito[]

  @@index([integracaoId])
  @@index([iniciadoPorUsuarioId])
  @@index([tipo])
  @@index([status])
  @@index([iniciadoEm])
  @@map("integracoes_sarh_execucoes")
}

model RegistroBrutoSarh {
  id String @id @default(uuid()) @db.Uuid

  execucaoId String @map("execucao_id") @db.Uuid

  endpoint     TipoEndpointSarh
  tipoRegistro TipoRegistroSarh @map("tipo_registro")
  chaveExterna String           @map("chave_externa") @db.VarChar(120)
  hashRegistro String           @map("hash_registro") @db.VarChar(128)

  payload    Json
  processado Boolean @default(false)

  criadoEm DateTime @default(now()) @map("criado_em")

  execucao IntegracaoSarhExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  itens    IntegracaoSarhItem[]

  @@unique([tipoRegistro, chaveExterna, hashRegistro])
  @@index([execucaoId])
  @@index([endpoint])
  @@index([tipoRegistro, chaveExterna])
  @@index([hashRegistro])
  @@map("registros_brutos_sarh")
}

model IntegracaoSarhItem {
  id String @id @default(uuid()) @db.Uuid

  execucaoId      String  @map("execucao_id") @db.Uuid
  registroBrutoId String? @map("registro_bruto_id") @db.Uuid

  endpoint     TipoEndpointSarh
  tipoRegistro TipoRegistroSarh @map("tipo_registro")
  chaveExterna String           @map("chave_externa") @db.VarChar(120)

  operacao OperacaoRegistroSarh
  status   StatusRegistroIntegracaoSarh @default(PENDENTE)

  entidadeInterna   String? @map("entidade_interna") @db.VarChar(120)
  entidadeInternaId String? @map("entidade_interna_id") @db.VarChar(120)

  mensagem String? @db.Text
  erro     String? @db.Text

  dadosAntes  Json? @map("dados_antes")
  dadosDepois Json? @map("dados_depois")
  metadados   Json?

  criadoEm DateTime @default(now()) @map("criado_em")

  execucao      IntegracaoSarhExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  registroBruto RegistroBrutoSarh?     @relation(fields: [registroBrutoId], references: [id], onDelete: SetNull)

  @@index([execucaoId])
  @@index([registroBrutoId])
  @@index([endpoint])
  @@index([tipoRegistro, chaveExterna])
  @@index([operacao])
  @@index([status])
  @@map("integracoes_sarh_itens")
}

model IntegracaoSarhConflito {
  id String @id @default(uuid()) @db.Uuid

  execucaoId String @map("execucao_id") @db.Uuid

  tipoRegistro TipoRegistroSarh @map("tipo_registro")
  chaveExterna String           @map("chave_externa") @db.VarChar(120)

  entidadeInterna   String? @map("entidade_interna") @db.VarChar(120)
  entidadeInternaId String? @map("entidade_interna_id") @db.VarChar(120)

  campo     String @db.VarChar(120)
  valorSarh Json?  @map("valor_sarh")
  valorSecp Json?  @map("valor_secp")

  status StatusConflitoSarh @default(PENDENTE)

  resolvidoPorUsuarioId  String?   @map("resolvido_por_usuario_id") @db.Uuid
  resolvidoEm            DateTime? @map("resolvido_em")
  justificativaResolucao String?   @map("justificativa_resolucao") @db.Text

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  execucao            IntegracaoSarhExecucao @relation(fields: [execucaoId], references: [id], onDelete: Cascade)
  resolvidoPorUsuario Usuario?               @relation("ConflitosSarhResolvidosPorUsuario", fields: [resolvidoPorUsuarioId], references: [id], onDelete: SetNull)

  @@index([execucaoId])
  @@index([tipoRegistro, chaveExterna])
  @@index([entidadeInterna, entidadeInternaId])
  @@index([status])
  @@map("integracoes_sarh_conflitos")
}

model EquipamentoBiometrico {
  id           String  @id @default(uuid()) @db.Uuid
  integracaoId String? @map("integracao_id") @db.Uuid
  orgaoId      String? @map("orgao_id") @db.Uuid
  unidadeId    String? @map("unidade_id") @db.Uuid

  codigo      String  @unique @db.VarChar(80)
  nome        String  @db.VarChar(160)
  fabricante  String? @db.VarChar(120)
  modelo      String? @db.VarChar(120)
  numeroSerie String? @map("numero_serie") @db.VarChar(120)

  localizacao String? @db.VarChar(200)
  ip          String? @db.VarChar(80)
  porta       Int?

  ativo                 Boolean   @default(true)
  ultimoHeartbeatEm     DateTime? @map("ultimo_heartbeat_em")
  ultimaSincronizacaoEm DateTime? @map("ultima_sincronizacao_em")

  configuracao Json?
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  integracao IntegracaoSistema?            @relation(fields: [integracaoId], references: [id], onDelete: SetNull)
