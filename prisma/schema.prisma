  seiProcessReference String?                     @map("sei_process_reference") @db.VarChar(120)
  decidedAt           DateTime                    @default(now()) @map("decided_at")
  policySnapshot      Json?                       @map("policy_snapshot")
  workflowSnapshot    Json?                       @map("workflow_snapshot")
  metadata            Json?

  request OvertimeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([authorityUserId])
  @@index([budgetReviewId])
  @@index([result])
  @@index([decidedAt])
  @@map("overtime_final_decisions")
}

model OvertimeAuthorization {
  id         String @id @default(uuid()) @db.Uuid
  orgaoId    String @map("orgao_id") @db.Uuid
  requestId  String @map("request_id") @db.Uuid
  decisionId String @map("decision_id") @db.Uuid
  employeeId String @map("employee_id") @db.Uuid

  status                  OvertimeAuthorizationStatus @default(ACTIVE)
  validFrom               DateTime                    @map("valid_from") @db.Date
  validUntil              DateTime                    @map("valid_until") @db.Date
  totalApprovedMinutes    Int                         @map("total_approved_minutes")
  policySnapshot          Json                        @map("policy_snapshot")
  workflowSnapshot        Json                        @map("workflow_snapshot")
  previousAuthorizationId String?                     @map("previous_authorization_id") @db.Uuid
  createdAt               DateTime                    @default(now()) @map("created_at")
  updatedAt               DateTime                    @updatedAt @map("updated_at")

  request OvertimeRequest            @relation(fields: [requestId], references: [id], onDelete: Restrict)
  days    OvertimeAuthorizationDay[]

  @@index([orgaoId])
  @@index([requestId])
  @@index([decisionId])
  @@index([employeeId])
  @@index([status])
  @@index([validFrom, validUntil])
  @@map("overtime_authorizations")
}

model OvertimeAuthorizationDay {
  id              String  @id @default(uuid()) @db.Uuid
  authorizationId String  @map("authorization_id") @db.Uuid
  requestDayId    String? @map("request_day_id") @db.Uuid

  date              DateTime        @db.Date
  approvedStartTime String?         @map("approved_start_time") @db.VarChar(5)
  approvedEndTime   String?         @map("approved_end_time") @db.VarChar(5)
  approvedMinutes   Int             @map("approved_minutes")
  dayType           OvertimeDayType @map("day_type")
  ratePercent       Decimal         @map("rate_percent") @db.Decimal(7, 4)
  metadata          Json?
  createdAt         DateTime        @default(now()) @map("created_at")

  authorization OvertimeAuthorization @relation(fields: [authorizationId], references: [id], onDelete: Cascade)

  @@unique([authorizationId, date])
  @@index([requestDayId])
  @@index([date])
  @@map("overtime_authorization_days")
}

model OvertimePayrollBatch {
  id      String @id @default(uuid()) @db.Uuid
  orgaoId String @map("orgao_id") @db.Uuid

  competence      String                     @db.VarChar(7)
  status          OvertimePayrollBatchStatus @default(DRAFT)
  filters         Json?
  totalEmployees  Int                        @default(0) @map("total_employees")
  totalMinutes    Int                        @default(0) @map("total_minutes")
  totalAmount     Decimal                    @default(0) @map("total_amount") @db.Decimal(14, 2)
  checksum        String?                    @db.VarChar(128)
  createdByUserId String?                    @map("created_by_user_id") @db.Uuid
  closedByUserId  String?                    @map("closed_by_user_id") @db.Uuid
  closedAt        DateTime?                  @map("closed_at")
  createdAt       DateTime                   @default(now()) @map("created_at")
  updatedAt       DateTime                   @updatedAt @map("updated_at")

  employees OvertimePayrollBatchEmployee[]
  lines     OvertimePayrollBatchLine[]

  @@index([orgaoId])
  @@index([competence])
  @@index([status])
  @@index([createdByUserId])
  @@index([closedAt])
  @@map("overtime_payroll_batches")
}

model OvertimePayrollBatchEmployee {
  id      String @id @default(uuid()) @db.Uuid
  batchId String @map("batch_id") @db.Uuid

  employeeId              String   @map("employee_id") @db.Uuid
  registration            String?  @db.VarChar(50)
  employeeName            String?  @map("employee_name") @db.VarChar(200)
  organizationalUnitLabel String?  @map("organizational_unit_label") @db.VarChar(200)
  totalMinutes            Int      @default(0) @map("total_minutes")
  totalAmount             Decimal  @default(0) @map("total_amount") @db.Decimal(14, 2)
  metadata                Json?
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  batch OvertimePayrollBatch       @relation(fields: [batchId], references: [id], onDelete: Cascade)
  lines OvertimePayrollBatchLine[]

  @@unique([batchId, employeeId])
  @@index([batchId])
  @@index([employeeId])
  @@map("overtime_payroll_batch_employees")
}

model OvertimePayrollBatchLine {
  id              String @id @default(uuid()) @db.Uuid
  batchId         String @map("batch_id") @db.Uuid
  batchEmployeeId String @map("batch_employee_id") @db.Uuid

  authorizationId    String   @map("authorization_id") @db.Uuid
  authorizationDayId String   @map("authorization_day_id") @db.Uuid
  requestId          String   @map("request_id") @db.Uuid
  employeeId         String   @map("employee_id") @db.Uuid
  date               DateTime @db.Date
  competence         String   @db.VarChar(7)
  minutes            Int
  ratePercent        Decimal  @map("rate_percent") @db.Decimal(7, 4)
  amount             Decimal  @default(0) @db.Decimal(14, 2)
  rubricaCode        String?  @map("rubrica_code") @db.VarChar(80)
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")

  batch         OvertimePayrollBatch         @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchEmployee OvertimePayrollBatchEmployee @relation(fields: [batchEmployeeId], references: [id], onDelete: Cascade)

  @@unique([batchId, authorizationDayId])
  @@index([batchId])
  @@index([batchEmployeeId])
  @@index([employeeId])
  @@index([authorizationId])
  @@index([authorizationDayId])
  @@index([competence])
  @@map("overtime_payroll_batch_lines")
}
