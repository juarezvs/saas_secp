model Usuario {
  id                         String      @id @default(uuid()) @db.Uuid
  matricula                  String      @unique @db.VarChar(50)
  cpf                        String?     @unique @db.VarChar(11)
  nome                       String      @db.VarChar(200)
  email                      String?     @unique @db.VarChar(200)
  senhaHash                  String?     @map("senha_hash") @db.VarChar(255)
  tipo                       TipoUsuario @default(SERVIDOR)
  ativo                      Boolean     @default(true)
  preferenciasAcessibilidade Json?       @map("preferencias_acessibilidade")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  perfis                           UsuarioPerfil[]
  servidor                         Servidor?
  auditorias                       AuditoriaEvento[]
  marcacoesCriadas                 Marcacao[]                @relation("MarcacoesCriadasPorUsuario")
  movimentosBancoHorasAutorizados  MovimentoBancoHoras[]     @relation("MovimentosBancoHorasAutorizadosPor")
  autorizacoesBancoHorasConcedidas AutorizacaoBancoHoras[]   @relation("AutorizacoesBancoHorasConcedidasPor")
  jornadasDiferenciadasAutorizadas JornadaServidor[]         @relation("JornadasDiferenciadasAutorizadasPor")
  solicitacoesCriadas              Solicitacao[]             @relation("SolicitacoesCriadasPorUsuario")
  solicitacoesAnalisadas           Solicitacao[]             @relation("SolicitacoesAnalisadasPorUsuario")
  solicitacaoEventos               SolicitacaoEvento[]       @relation("SolicitacaoEventosPorUsuario")
  fechamentosAbertos               FechamentoMensalUnidade[] @relation("FechamentosAbertosPorUsuario")
  fechamentosHomologados           FechamentoMensalUnidade[] @relation("FechamentosHomologadosPorUsuario")
  homologacoesServidor             HomologacaoServidorMes[]  @relation("HomologacoesServidorPorUsuario")
  boletinsGerados                  BoletimFrequencia[]       @relation("BoletinsGeradosPorUsuario")
  boletinsEncaminhados             BoletimFrequencia[]       @relation("BoletinsEncaminhadosPorUsuario")
  boletinsRecebidos                BoletimFrequencia[]       @relation("BoletinsRecebidosPorUsuario")
  integracoesSarhExecutadas        IntegracaoSarhExecucao[]  @relation("IntegracoesSarhExecutadasPorUsuario")
  conflitosSarhResolvidos          IntegracaoSarhConflito[]  @relation("ConflitosSarhResolvidosPorUsuario")
  recessosCriados                  RecessoForense[]          @relation("RecessosCriadosPorUsuario")
  recessosFechados                 RecessoForense[]          @relation("RecessosFechadosPorUsuario")
  convocacoesRecessoCriadas        ConvocacaoRecesso[]       @relation("ConvocacoesRecessoCriadasPorUsuario")
  convocadosRecessoFechados        ConvocadoRecesso[]        @relation("ConvocadosRecessoFechadosPorUsuario")
  homologacoesRecesso              HomologacaoRecesso[]      @relation("HomologacoesRecessoPorUsuario")
  aceitesRecessoSecad              HomologacaoRecesso[]      @relation("AceitesRecessoSecadPorUsuario")
  sessoesCadastroFacial            SessaoCadastroFacial[]
  notificacoesLidas                NotificacaoLeitura[]
  documentosAutenticacaoCriados    DocumentoAutenticacao[]   @relation("DocumentosAutenticacaoCriadosPorUsuario")
  teamsVinculos                    TeamsUsuarioVinculado[]
  teamsLogs                        TeamsLog[]
  teamsNotificacoes                TeamsNotificacao[]

  @@map("usuarios")
}

model NotificacaoLeitura {
  id            String   @id @default(uuid()) @db.Uuid
  usuarioId     String   @map("usuario_id") @db.Uuid
  notificacaoId String   @map("notificacao_id") @db.VarChar(160)
  lidaEm        DateTime @default(now()) @map("lida_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, notificacaoId])
  @@index([usuarioId])
  @@index([notificacaoId])
  @@map("notificacoes_lidas")
}

model DocumentoAutenticacao {
  id String @id @default(uuid()) @db.Uuid

  codigo        String @unique @db.VarChar(20)
  crc           String @db.VarChar(12)
  tipoDocumento String @map("tipo_documento") @db.VarChar(80)
  entidade      String @db.VarChar(120)
  entidadeId    String @map("entidade_id") @db.VarChar(120)

  titulo            String  @db.VarChar(220)
  competencia       String? @db.VarChar(20)
  orgao             String? @db.VarChar(120)
  unidade           String? @db.VarChar(180)
  servidorNome      String? @map("servidor_nome") @db.VarChar(200)
  servidorMatricula String? @map("servidor_matricula") @db.VarChar(50)

  hashDocumento String @map("hash_documento") @db.VarChar(128)
  dadosResumo   Json?  @map("dados_resumo")
  assinaturas   Json?

  criadoPorUsuarioId String?  @map("criado_por_usuario_id") @db.Uuid
  criadoEm           DateTime @default(now()) @map("criado_em")
  atualizadoEm       DateTime @updatedAt @map("atualizado_em")

  criadoPor Usuario? @relation("DocumentosAutenticacaoCriadosPorUsuario", fields: [criadoPorUsuarioId], references: [id], onDelete: SetNull)

  @@index([codigo])
  @@index([crc])
  @@index([tipoDocumento])
  @@index([entidade, entidadeId])
  @@index([tipoDocumento, entidade, entidadeId, competencia])
  @@index([hashDocumento])
  @@index([criadoEm])
  @@map("documentos_autenticacao")
}

model Perfil {
  id        String  @id @default(uuid()) @db.Uuid
  codigo    String  @unique @db.VarChar(80)
  nome      String  @db.VarChar(120)
  descricao String? @db.Text
  sistema   Boolean @default(false)
  ativo     Boolean @default(true)
  administrativo Boolean @default(false)
  excecao   Boolean @default(false) @map("excecao")
  perfilDestinoExcecaoId String? @map("perfil_destino_excecao_id") @db.Uuid

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  usuarios   UsuarioPerfil[]
  permissoes PerfilPermissao[]
  menusGrupos MenuGrupoPerfil[]
  menusItens MenuItemPerfil[]
  perfilDestinoExcecao Perfil? @relation("PerfilExcecaoDestino", fields: [perfilDestinoExcecaoId], references: [id], onDelete: SetNull)
  excecoesRecebidas Perfil[] @relation("PerfilExcecaoDestino")

  @@index([perfilDestinoExcecaoId])

  @@map("perfis")
}

model MenuGrupoPerfil {
  id String @id @default(uuid()) @db.Uuid

  perfilId String @map("perfil_id") @db.Uuid
  label    String @db.VarChar(120)
  icone    String? @db.VarChar(80)
  ordem    Int    @default(0)
  ativo    Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  itens  MenuItemPerfil[]

  @@index([perfilId, ordem])
  @@map("menus_grupos_perfil")
}

model MenuItemPerfil {
  id String @id @default(uuid()) @db.Uuid

  perfilId     String  @map("perfil_id") @db.Uuid
  grupoId      String? @map("grupo_id") @db.Uuid
  itemCatalogo String  @map("item_catalogo") @db.VarChar(160)
  label        String? @db.VarChar(120)
  ordem        Int     @default(0)
  ativo        Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  perfil Perfil @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  grupo  MenuGrupoPerfil? @relation(fields: [grupoId], references: [id], onDelete: Cascade)

  @@index([perfilId, ordem])
  @@index([grupoId, ordem])
  @@map("menus_itens_perfil")
}

model Permissao {
  id        String  @id @default(uuid()) @db.Uuid
  codigo    String  @unique @db.VarChar(160)
  recurso   String  @db.VarChar(80)
  acao      String  @db.VarChar(80)
  escopo    String  @db.VarChar(80)
  descricao String? @db.Text

  criadoEm DateTime @default(now()) @map("criado_em")

  perfis PerfilPermissao[]

  @@unique([recurso, acao, escopo])
  @@map("permissoes")
}

model LiberacaoRotina {
  id String @id @default(uuid()) @db.Uuid

  tipo     TipoLiberacaoRotina
  chave    String              @db.VarChar(160)
  liberada Boolean             @default(true)

  atualizadoPorUsuarioId String?  @map("atualizado_por_usuario_id") @db.Uuid
  criadoEm               DateTime @default(now()) @map("criado_em")
  atualizadoEm           DateTime @updatedAt @map("atualizado_em")

  @@unique([tipo, chave])
  @@index([tipo])
  @@index([liberada])
  @@map("rotinas_liberacoes")
}

model UsuarioPerfil {
  id String @id @default(uuid()) @db.Uuid

  usuarioId String  @map("usuario_id") @db.Uuid
  perfilId  String  @map("perfil_id") @db.Uuid
  orgaoId   String? @map("orgao_id") @db.Uuid

  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  perfil  Perfil  @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  orgao   Orgao?  @relation(fields: [orgaoId], references: [id], onDelete: Cascade)

  @@index([usuarioId, perfilId, orgaoId])
  @@index([usuarioId])
  @@index([perfilId])
  @@index([orgaoId])
  @@map("usuarios_perfis")
}

model PerfilPermissao {
  id String @id @default(uuid()) @db.Uuid

  perfilId    String @map("perfil_id") @db.Uuid
  permissaoId String @map("permissao_id") @db.Uuid

  criadoEm DateTime @default(now()) @map("criado_em")

  perfil    Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@unique([perfilId, permissaoId])
  @@index([perfilId])
  @@index([permissaoId])
  @@map("perfis_permissoes")
}

model Orgao {
  id            String  @id @default(uuid()) @db.Uuid
  sigla         String  @unique @db.VarChar(30)
  nome          String  @db.VarChar(200)
  ativo         Boolean @default(true)
  fusoHorario   String? @map("fuso_horario") @db.VarChar(80)
  uf            String? @db.Char(2)
  municipio     String? @db.VarChar(120)
  municipioIbge String? @map("municipio_ibge") @db.VarChar(7)

  codigoExternoSarh       Int?      @unique @map("codigo_externo_sarh")
  dataInicioSarh          DateTime? @map("data_inicio_sarh") @db.Date
  dataFimSarh             DateTime? @map("data_fim_sarh") @db.Date
  ultimaSincronizacaoSarh DateTime? @map("ultima_sincronizacao_sarh")
  payloadSarh             Json?     @map("payload_sarh")

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  unidades                    UnidadeOrganizacional[]
  servidores                  Servidor[]
  equipamentosBiometricos     EquipamentoBiometrico[]
  regulamentacaoPonto         RegulamentacaoPontoOrgao?
  integracoes                 IntegracaoSistema[]
  calendariosInstitucionais   CalendarioInstitucional[]
  usuariosPerfis              UsuarioPerfil[]
  overtimePolicies            OvertimePolicy[]
  overtimeWorkflowDefinitions OvertimeWorkflowDefinition[]

  @@index([uf])
  @@index([municipioIbge])
  @@map("orgaos")
}

model FusoHorario {
  id String @id @default(uuid()) @db.Uuid

  valor     String  @unique @db.VarChar(80)
  rotulo    String  @db.VarChar(120)
  descricao String? @db.Text
  ativo     Boolean @default(true)

  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  @@index([ativo])
  @@map("fusos_horarios")
}

model RegulamentacaoPontoOrgao {
  id String @id @default(uuid()) @db.Uuid

  orgaoId String @unique @map("orgao_id") @db.Uuid

  numeroPortaria String? @map("numero_portaria") @db.VarChar(120)
