model BiometriaFacialServidor {
  id         String @id @default(uuid()) @db.Uuid
  servidorId String @unique @map("servidor_id") @db.Uuid

  status StatusCadastroFacial @default(PENDENTE)

  algoritmo       String  @default("human-face-description") @db.VarChar(120)
  versaoAlgoritmo String? @map("versao_algoritmo") @db.VarChar(80)

  template              Json
  templateCriptografado String? @map("template_criptografado") @db.Text
  templateIv            String? @map("template_iv") @db.VarChar(64)
  templateTag           String? @map("template_tag") @db.VarChar(64)
  templateHash          String? @map("template_hash") @db.VarChar(128)
  templateDimensao      Int     @map("template_dimensao")
  qualidadeMedia        Float?  @map("qualidade_media")
  amostrasQuantidade    Int     @default(0) @map("amostras_quantidade")

  limiarDistancia Float @default(0.55) @map("limiar_distancia")

  termoAceiteEm          DateTime? @map("termo_aceite_em")
  cadastradoPorUsuarioId String?   @map("cadastrado_por_usuario_id") @db.Uuid
  atualizadoPorUsuarioId String?   @map("atualizado_por_usuario_id") @db.Uuid
  revogadoPorUsuarioId   String?   @map("revogado_por_usuario_id") @db.Uuid

  revogadoEm   DateTime? @map("revogado_em")
  criadoEm     DateTime  @default(now()) @map("criado_em")
  atualizadoEm DateTime  @updatedAt @map("atualizado_em")

  servidor Servidor                  @relation(fields: [servidorId], references: [id], onDelete: Cascade)
  amostras AmostraBiometricaFacial[]

  @@index([status])
  @@map("biometrias_faciais_servidores")
}

model AmostraBiometricaFacial {
  id          String  @id @default(uuid()) @db.Uuid
  biometriaId String? @map("biometria_id") @db.Uuid
  servidorId  String  @map("servidor_id") @db.Uuid

  tipo         TipoAmostraFacial
  template     Json?
  templateHash String?           @map("template_hash") @db.VarChar(128)
  qualidade    Float?
  distancia    Float?
  similaridade Float?
  validada     Boolean           @default(false)

  metadados          Json?
  criadoPorUsuarioId String?  @map("criado_por_usuario_id") @db.Uuid
  criadoEm           DateTime @default(now()) @map("criado_em")

  biometria            BiometriaFacialServidor?        @relation(fields: [biometriaId], references: [id], onDelete: SetNull)
  servidor             Servidor                        @relation(fields: [servidorId], references: [id], onDelete: Cascade)
  autorizacoesMarcacao AutorizacaoBiometricaMarcacao[]

  @@index([biometriaId])
  @@index([servidorId])
  @@index([tipo])
  @@index([validada])
  @@index([criadoEm])
  @@map("biometrias_faciais_amostras")
}

model SessaoCadastroFacial {
