model EventoEquipamentoBiometrico {
  id            String  @id @default(uuid()) @db.Uuid
  equipamentoId String  @map("equipamento_id") @db.Uuid
  marcacaoId    String? @map("marcacao_id") @db.Uuid

  tipoEvento          TipoEventoEquipamento @default(MARCACAO) @map("tipo_evento")
  codigoEventoExterno String?               @map("codigo_evento_externo") @db.VarChar(120)
  nsr                 String?               @db.VarChar(120)

  matricula  String?   @db.VarChar(80)
  dataHora   DateTime? @map("data_hora")
  recebidoEm DateTime  @default(now()) @map("recebido_em")

  processado   Boolean   @default(false)
  processadoEm DateTime? @map("processado_em")
  erro         String?   @db.Text

  payload Json?

  equipamento EquipamentoBiometrico @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  marcacao    Marcacao?             @relation(fields: [marcacaoId], references: [id], onDelete: SetNull)

  @@unique([equipamentoId, codigoEventoExterno])
  @@unique([equipamentoId, nsr])
  @@index([equipamentoId])
  @@index([marcacaoId])
  @@index([matricula])
  @@index([dataHora])
  @@index([processado])
  @@map("equipamentos_biometricos_eventos")
