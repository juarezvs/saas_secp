  @@unique([hashArquivo])
  @@index([importacaoId])
  @@index([status])
  @@map("afd_arquivos")
}

model CalendarioInstitucional {
  id String @id @default(uuid()) @db.Uuid

  dataReferencia DateTime                           @map("data_referencia") @db.Date
  descricao      String                             @db.VarChar(200)
