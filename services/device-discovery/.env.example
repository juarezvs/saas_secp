# Gere um valor aleatório (>=32 caracteres); use o mesmo SOMENTE no backend Next.js.
DISCOVERY_GATEWAY_SECRET=
DISCOVERY_ENVIRONMENT=production
DISCOVERY_PORT=8041
# Escolha uma sub-rede Docker sem sobreposição com as redes institucionais/VPN.
DISCOVERY_DOCKER_SUBNET=172.31.254.0/28
# Banco próprio. Para PostgreSQL, crie banco e usuário exclusivos previamente.
DISCOVERY_DATABASE_URL=sqlite:////data/discovery.db
# DISCOVERY_DATABASE_URL=postgresql+psycopg://discovery:SENHA@HOST:5432/secp_discovery
# Redis é opcional. A fila durável é SQL, com leases e confirmação idempotente.
DISCOVERY_REDIS_URL=
DISCOVERY_TLS_CERT=/certs/server.crt
DISCOVERY_TLS_KEY=/certs/server.key
# CA e nome devem corresponder ao certificado. SAN 127.0.0.1 permite health check local.
DISCOVERY_CA_FILE=/certs/ca.crt
DISCOVERY_HEALTH_URL=https://127.0.0.1:8000/health/ready
# Backend Next.js (variáveis somente do servidor; nunca NEXT_PUBLIC_*):
# DISCOVERY_SERVICE_URL=https://discovery.sua-rede.interna:8041
# DISCOVERY_GATEWAY_SECRET=<mesmo valor gerado acima>
