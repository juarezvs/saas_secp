<!-- Exemplo para WinSW. Use uma conta dedicada; proteja config/estado com ACL dessa conta. -->
<service>
  <id>SECPDiscoveryAgent</id>
  <name>SECP Discovery Agent</name>
  <description>Descoberta administrativa nas redes explicitamente autorizadas.</description>
  <executable>%BASE%\venv\Scripts\python.exe</executable>
  <arguments>-m discovery.agent --config "%BASE%\agent.json"</arguments>
  <workingdirectory>%BASE%</workingdirectory>
  <logpath>%BASE%\logs</logpath>
  <log mode="roll-by-size"><sizeThreshold>10240</sizeThreshold><keepFiles>3</keepFiles></log>
  <onfailure action="restart" delay="10 sec" />
  <stoptimeout>30 sec</stoptimeout>
</service>
