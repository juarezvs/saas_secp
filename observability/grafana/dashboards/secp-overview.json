{
  "uid": "secp-overview",
  "title": "SECP - Visao Geral",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "timezone": "browser",
  "tags": ["secp", "overview"],
  "panels": [
    {
      "type": "stat",
      "title": "SECP up",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "up{job=\"secp\"}", "refId": "A" }
      ]
    },
    {
      "type": "stat",
      "title": "Erro HTTP 5m",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "secp:http_error_rate5m", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percentunit", "decimals": 2 },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Requisicoes por rota",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (route, method) (secp:http_request_rate5m)", "legendFormat": "{{method}} {{route}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latencia p95 por rota",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "secp:http_latency_p95_5m", "legendFormat": "{{method}} {{route}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Filas BullMQ",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "sum by (queue, state) (secp_queue_jobs)", "legendFormat": "{{queue}} {{state}}", "refId": "A" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memoria containers SECP",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [
        { "expr": "secp:container_memory_usage_bytes", "legendFormat": "{{name}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" },
        "overrides": []
      }
    }
  ]
}

